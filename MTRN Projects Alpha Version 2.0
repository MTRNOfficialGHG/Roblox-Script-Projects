local TpBtn = Instance.new("TextButton")
TpBtn.Size = UDim2.new(1, -30, 0, 35)
TpBtn.BackgroundColor3 = Color3.fromRGB(60, 150, 80)
TpBtn.Text = "Teleport"
TpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
TpBtn.Font = Enum.Font.GothamBold
TpBtn.TextSize = 13
TpBtn.Parent = PlayerPage
local TpCorner = Instance.new("UICorner")
TpCorner.CornerRadius = UDim.new(0, 6)
TpCorner.Parent = TpBtn
TpBtn.MouseButton1Click:Connect(function()
    local text = CoordsBox.Text
    local success, x, y, z = pcall(function()
        local parts = {}
        for part in string.gmatch(text, "[^,%s]+") do table.insert(parts, tonumber(part)) end
        return parts[1], parts[2], parts[3]
    end)
    if success and x and y and z then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(x, y + 3, z)
            SendNotification("Teleported successfully!", Color3.fromRGB(80, 255, 80))
        end
    else
        SendNotification("Invalid coordinates format!", Color3.fromRGB(255, 80, 80))
    end
end)

