CreateToggle(ESPPage, "Name, Distance & HP", function(state) espNameEnabled = state end)
CreateToggle(ESPPage, "Chams ESP", function(state) espChamsEnabled = state end)
CreateToggle(ESPPage, "Box ESP", function(state) espBoxEnabled = state end)
CreateToggle(ESPPage, "Tracers ESP", function(state) espTracersEnabled = state end)
