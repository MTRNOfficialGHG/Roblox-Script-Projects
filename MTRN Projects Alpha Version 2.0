VisPaddingTop.BackgroundTransparency = 1
VisPaddingTop.Parent = VisualsPage

local fbConn
CreateToggle(VisualsPage, "Fullbright", function(state)
    if state then
        fbConn = RunService.RenderStepped:Connect(function()
            game.Lighting.Ambient = Color3.new(1, 1, 1)
            game.Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
            game.Lighting.Brightness = 2
            game.Lighting.ClockTime = 12
        end)
    else
        if fbConn then fbConn:Disconnect() end
    end
end)

local originalTransparencies = {}
CreateToggle(VisualsPage, "X-Ray", function(state)
    if state then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                if not obj:FindFirstAncestorOfClass("Model") or not obj:FindFirstAncestorOfClass("Model"):FindFirstChild("Humanoid") then
                    originalTransparencies[obj] = obj.Transparency
                    obj.Transparency = 0.5
                end
            end
        end
    else
        for obj, trans in pairs(originalTransparencies) do
            if obj and obj.Parent then obj.Transparency = trans end
        end
        originalTransparencies = {}
    end
end)

CreateToggle(VisualsPage, "FPS Boost", function(state)
    if state then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not obj:FindFirstAncestorOfClass("Model") then
                obj.Material = Enum.Material.SmoothPlastic
            elseif obj:IsA("Texture") or obj:IsA("Decal") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") then
                if obj.Name ~= "c00lkidd_decal" then
                    obj:Destroy()
                end
            end
        end
        game.Lighting.GlobalShadows = false
        SendNotification("FPS Boost Applied!", Color3.fromRGB(60, 180, 80))
    end
end)

CreateToggle(VisualsPage, "Infinity Zoom", function(state)
    if state then
        LocalPlayer.CameraMaxZoomDistance = math.huge
    else
        LocalPlayer.CameraMaxZoomDistance = 400
    end
end)

-- HIER KANNST DU DEINE EIGENE ID EINTRAGEN, WENN DU DEIN BILD HOCHLÄDST!
local c00lkiddTexture = "rbxassetid://8408806737" 

CreateToggle(VisualsPage, "c00lkidd Mode", function(state)
    if state then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local faces = {Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right}
                for _, face in ipairs(faces) do
                    local decal = Instance.new("Decal")
                    decal.Name = "c00lkidd_decal"
                    decal.Texture = c00lkiddTexture
                    decal.Face = face
                    decal.Parent = obj
                end
            end
        end
    else
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Decal") and obj.Name == "c00lkidd_decal" then
                obj:Destroy()
            end
        end
    end
end)

