local function AddChatLog(player, message)
    local msgLbl = Instance.new("TextLabel")
    msgLbl.Size = UDim2.new(1, -10, 0, 20)
    msgLbl.BackgroundTransparency = 1
    msgLbl.Text = "[" .. player .. "]: " .. message
    msgLbl.TextColor3 = Color3.fromRGB(220, 220, 220)
    msgLbl.Font = Enum.Font.Gotham
    msgLbl.TextSize = 12
    msgLbl.TextWrapped = true
    msgLbl.TextXAlignment = Enum.TextXAlignment.Left
    msgLbl.Parent = ChatScroll
    msgLbl.Size = UDim2.new(1, -10, 0, msgLbl.TextBounds.Y + 5)
    ChatScroll.CanvasSize = UDim2.new(0, 0, 0, ChatLayout.AbsoluteContentSize.Y)
    ChatScroll.CanvasPosition = Vector2.new(0, ChatScroll.CanvasSize.Y.Offset)
end
for _, player in ipairs(Players:GetPlayers()) do
    player.Chatted:Connect(function(msg) AddChatLog(player.Name, msg) end)
end
Players.PlayerAdded:Connect(function(player)
    player.Chatted:Connect(function(msg) AddChatLog(player.Name, msg) end)
end)

