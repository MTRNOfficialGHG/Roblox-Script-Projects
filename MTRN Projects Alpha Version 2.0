-- === ESP ENGINE ===
local ESPGui = Instance.new("ScreenGui")
ESPGui.Name = "MTRN_ESP_Gui"
ESPGui.IgnoreGuiInset = true
ESPGui.Parent = CoreGui

local espCache = {}

local function isTeammate(plr)
    if not espTeamCheckEnabled then return false end
    if LocalPlayer.Team and plr.Team then
        return LocalPlayer.Team == plr.Team
    end
    return false
end

local function getHpColor(health, maxHealth)
    local pct = math.clamp(health / maxHealth, 0, 1)
    return Color3.fromRGB(math.floor((1 - pct) * 255), math.floor(pct * 255), 0)
end

RunService.RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            
            local cache = espCache[plr]
            if not cache then
                cache = {
                    container = Instance.new("Frame"),
                    boxFrame = Instance.new("Frame"),
                    boxStroke = Instance.new("UIStroke"),
                    hpBarBg = Instance.new("Frame"),
                    hpBarFill = Instance.new("Frame"),
                    nameLbl = Instance.new("TextLabel"),
                    infoLbl = Instance.new("TextLabel"),
                    highlight = Instance.new("Highlight"),
                    tracer = Drawing.new("Line")
                }
                cache.container.BackgroundTransparency = 1
                cache.container.Parent = ESPGui
                cache.boxFrame.BackgroundTransparency = 1
                cache.boxFrame.Parent = cache.container
                cache.boxStroke.Thickness = 1.5
                cache.boxStroke.Parent = cache.boxFrame
                cache.hpBarBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                cache.hpBarBg.BorderSizePixel = 0
                cache.hpBarBg.Parent = cache.container
                cache.hpBarFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                cache.hpBarFill.BorderSizePixel = 0
                cache.hpBarFill.Parent = cache.hpBarBg
                cache.nameLbl.BackgroundTransparency = 1
                cache.nameLbl.Font = Enum.Font.GothamBold
                cache.nameLbl.TextSize = 13
                cache.nameLbl.TextStrokeTransparency = 0.5
                cache.nameLbl.TextYAlignment = Enum.TextYAlignment.Bottom
                cache.nameLbl.Parent = cache.container
                cache.infoLbl.BackgroundTransparency = 1
                cache.infoLbl.Font = Enum.Font.GothamBold
                cache.infoLbl.TextSize = 12
                cache.infoLbl.TextStrokeTransparency = 0.5
                cache.infoLbl.TextYAlignment = Enum.TextYAlignment.Top
                cache.infoLbl.Parent = cache.container
                cache.tracer.Visible = false
                cache.tracer.Thickness = 1.5
                
                espCache[plr] = cache
            end
            
            local show = false
            if char and root and head and humanoid and humanoid.Health > 0 then
                local dist = (camera.CFrame.Position - root.Position).Magnitude
                if dist <= espMaxDistance then
                    local rootScreen, onScreen = camera:WorldToViewportPoint(root.Position)
                    local top3D = head.Position + Vector3.new(0, 0.5, 0)
                    local bottom3D = root.Position - Vector3.new(0, 3.5, 0)
                    
                    local topScreen = camera:WorldToViewportPoint(top3D)
                    local bottomScreen = camera:WorldToViewportPoint(bottom3D)
                    
                    if onScreen then
                        show = true
                        local height = math.abs(topScreen.Y - bottomScreen.Y)
                        local width = height * 0.6
                        
                        cache.container.Visible = true
                        cache.container.Size = UDim2.new(0, width, 0, height)
                        cache.container.Position = UDim2.new(0, rootScreen.X - (width/2), 0, topScreen.Y)
                        
                        local teamCol = isTeammate(plr) and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 50, 50)
                        local hue = (tick() * 0.5) % 1
                        
                        if espBoxEnabled then
                            cache.boxFrame.Visible = true
                            cache.boxFrame.Size = UDim2.new(1, 0, 1, 0)
                            cache.boxStroke.Color = teamCol
                        else
                            cache.boxFrame.Visible = false
                        end
                        
                        if espHPBarEnabled then
                            cache.hpBarBg.Visible = true
                            cache.hpBarBg.Size = UDim2.new(0, 3, 1, 0)
                            cache.hpBarBg.Position = UDim2.new(0, -6, 0, 0)
                            local hpRatio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                            cache.hpBarFill.Size = UDim2.new(1, 0, hpRatio, 0)
                            cache.hpBarFill.Position = UDim2.new(0, 0, 1 - hpRatio, 0)
                            cache.hpBarFill.BackgroundColor3 = getHpColor(humanoid.Health, humanoid.MaxHealth)
                        else
                            cache.hpBarBg.Visible = false
                        end
                        
                        if espNameEnabled then
                            cache.nameLbl.Visible = true
                            cache.nameLbl.Size = UDim2.new(1, 0, 0, 15)
                            cache.nameLbl.Position = UDim2.new(0, 0, 0, -17)
                            cache.nameLbl.Text = plr.Name
                            cache.nameLbl.TextColor3 = Color3.fromHSV(hue, 1, 1)
                            
                            cache.infoLbl.Visible = true
                            cache.infoLbl.Size = UDim2.new(1, 0, 0, 15)
                            cache.infoLbl.Position = UDim2.new(0, 0, 1, 2)
                            local hp = math.floor(humanoid.Health)
                            local maxHp = math.floor(humanoid.MaxHealth)
                            cache.infoLbl.Text = string.format("[%dm] HP: %d/%d", math.floor(dist), hp, maxHp)
                            cache.infoLbl.TextColor3 = getHpColor(hp, maxHp)
                        else
                            cache.nameLbl.Visible = false
                            cache.infoLbl.Visible = false
                        end
                        
                        if espChamsEnabled then
                            cache.highlight.Parent = char
                            cache.highlight.Adornee = char
                            cache.highlight.FillColor = teamCol
                            cache.highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                            cache.highlight.FillTransparency = 0.5
                            cache.highlight.OutlineTransparency = 0
                        else
                            cache.highlight.Parent = nil
                        end
                        
                        if espTracersEnabled then
                            cache.tracer.Visible = true
                            cache.tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                            cache.tracer.To = Vector2.new(bottomScreen.X, bottomScreen.Y)
                            cache.tracer.Color = teamCol
                        else
                            cache.tracer.Visible = false
                        end
                    end
                end
            end
            
            if not show then
                cache.container.Visible = false
                cache.highlight.Parent = nil
                cache.tracer.Visible = false
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    if espCache[plr] then
        espCache[plr].container:Destroy()
        if espCache[plr].highlight then espCache[plr].highlight:Destroy() end
        if espCache[plr].tracer then espCache[plr].tracer:Remove() end
        espCache[plr] = nil
    end
end)


-- === FLING & MISC TAB ===
local FlingPage = Instance.new("Frame")
FlingPage.Size = UDim2.new(1, 0, 1, 0)
FlingPage.BackgroundTransparency = 1
FlingPage.Visible = false
FlingPage.Parent = ContentArea

local FlingBtnsFrame = Instance.new("Frame")
FlingBtnsFrame.Size = UDim2.new(1, -30, 0, 35)
FlingBtnsFrame.Position = UDim2.new(0, 15, 0, 10)
FlingBtnsFrame.BackgroundTransparency = 1
FlingBtnsFrame.Parent = FlingPage

local function CreateTopBtn(parent, txt, col, xPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.23, 0, 1, 0)
    btn.Position = UDim2.new(xPos, 0, 0, 0)
    btn.BackgroundColor3 = col
    btn.Text = txt
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = btn
    return btn
end

local StartFlingBtn = CreateTopBtn(FlingBtnsFrame, "Start Fling", Color3.fromRGB(60, 180, 80), 0)
local StopFlingBtn = CreateTopBtn(FlingBtnsFrame, "Stop Fling", Color3.fromRGB(200, 60, 60), 0.25)
local SelectAllBtn = CreateTopBtn(FlingBtnsFrame, "Select All", Color3.fromRGB(80, 120, 200), 0.5)
local DeselectAllBtn = CreateTopBtn(FlingBtnsFrame, "Deselect All", Color3.fromRGB(100, 100, 100), 0.75)

local SlidersFrame = Instance.new("Frame")
SlidersFrame.Size = UDim2.new(1, 0, 0, 110)
SlidersFrame.Position = UDim2.new(0, 15, 0, 55)
SlidersFrame.BackgroundTransparency = 1
SlidersFrame.Parent = FlingPage

local followZ = 0
local followY = 0
CreateSlider(SlidersFrame, "Follow Distance (Front/Back)", -50, 50, 0, function(val) followZ = val end)
local SlidersLayout = Instance.new("UIListLayout")
SlidersLayout.Parent = SlidersFrame
SlidersLayout.SortOrder = Enum.SortOrder.LayoutOrder
SlidersLayout.Padding = UDim.new(0, 5)
CreateSlider(SlidersFrame, "Follow Elevation (Up/Down)", -50, 50, 0, function(val) followY = val end)

local PlayerListHeader = Instance.new("TextLabel")
PlayerListHeader.Size = UDim2.new(1, -30, 0, 20)
PlayerListHeader.Position = UDim2.new(0, 15, 0, 165)
PlayerListHeader.BackgroundTransparency = 1
PlayerListHeader.Text = "Player Target List"
PlayerListHeader.TextColor3 = Color3.fromRGB(255, 255, 255)
PlayerListHeader.Font = Enum.Font.GothamBold
PlayerListHeader.TextSize = 14
PlayerListHeader.TextXAlignment = Enum.TextXAlignment.Left
PlayerListHeader.Parent = FlingPage

local PlayerScroll = Instance.new("ScrollingFrame")
PlayerScroll.Size = UDim2.new(1, -30, 1, -195)
PlayerScroll.Position = UDim2.new(0, 15, 0, 185)
PlayerScroll.BackgroundColor3 = Color3.fromRGB(20, 25, 35)
PlayerScroll.BorderSizePixel = 0
PlayerScroll.ScrollBarThickness = 4
PlayerScroll.Parent = FlingPage
local PlayerScrollCorner = Instance.new("UICorner")
PlayerScrollCorner.CornerRadius = UDim.new(0, 6)
PlayerScrollCorner.Parent = PlayerScroll
local ListLayout = Instance.new("UIListLayout")
ListLayout.Parent = PlayerScroll
ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
ListLayout.Padding = UDim.new(0, 2)

local selectedForFling = {}
local toggleButtons = {}
local isFlinging = false
local originalPos = nil
local currentFlingIndex = 1

local followTarget = nil
local viewTarget = nil

local function RefreshPlayerList()
    for _, child in ipairs(PlayerScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    toggleButtons = {}
    
    local plist = Players:GetPlayers()
    table.sort(plist, function(a, b) return a.Name:lower() < b.Name:lower() end)
    
    for _, plr in ipairs(plist) do
        if plr ~= LocalPlayer then
            local pFrame = Instance.new("Frame")
            pFrame.Size = UDim2.new(1, -10, 0, 35)
            pFrame.BackgroundColor3 = Color3.fromRGB(25, 30, 45)
            pFrame.BorderSizePixel = 0
            pFrame.Parent = PlayerScroll
            
            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(0.35, 0, 1, 0)
            nameLbl.Position = UDim2.new(0, 10, 0, 0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = plr.Name
            nameLbl.TextColor3 = Color3.fromRGB(220, 220, 220)
            nameLbl.Font = Enum.Font.GothamSemibold
            nameLbl.TextSize = 12
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.Parent = pFrame
            
            local function makeActionBtn(txt, xOff, wid, color)
                local b = Instance.new("TextButton")
                b.Size = UDim2.new(wid, 0, 0, 25)
                b.Position = UDim2.new(0.35 + xOff, 0, 0.5, -12.5)
                b.BackgroundColor3 = color
                b.Text = txt
                b.TextColor3 = Color3.fromRGB(255, 255, 255)
                b.Font = Enum.Font.GothamBold
                b.TextSize = 11
                b.Parent = pFrame
                local c = Instance.new("UICorner")
                c.CornerRadius = UDim.new(0, 4)
                c.Parent = b
                return b
            end
            
            local tpBtn = makeActionBtn("TP", 0, 0.12, Color3.fromRGB(60, 150, 80))
            local folBtn = makeActionBtn("Follow", 0.14, 0.15, followTarget == plr and Color3.fromRGB(150, 150, 60) or Color3.fromRGB(80, 120, 200))
            local viewBtn = makeActionBtn("View", 0.31, 0.15, viewTarget == plr and Color3.fromRGB(150, 80, 150) or Color3.fromRGB(100, 100, 100))
            local selBtn = makeActionBtn(selectedForFling[plr] and "Selected" or "Select", 0.48, 0.15, selectedForFling[plr] and Color3.fromRGB(60, 180, 80) or Color3.fromRGB(200, 60, 60))
            
            toggleButtons[plr] = selBtn
            
            tpBtn.MouseButton1Click:Connect(function()
                if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = plr.Character.HumanoidRootPart.CFrame
                    SendNotification("Teleported to " .. plr.Name, Color3.fromRGB(60, 180, 80))
                end
            end)
            
            folBtn.MouseButton1Click:Connect(function()
                if followTarget == plr then
                    followTarget = nil
                    folBtn.BackgroundColor3 = Color3.fromRGB(80, 120, 200)
                    SendNotification("Stopped following", Color3.fromRGB(200, 60, 60))
                else
                    followTarget = plr
                    RefreshPlayerList()
                    SendNotification("Following " .. plr.Name, Color3.fromRGB(80, 120, 200))
                end
            end)
            
            viewBtn.MouseButton1Click:Connect(function()
                if viewTarget == plr then
                    viewTarget = nil
                    workspace.CurrentCamera.CameraSubject = LocalPlayer.Character:FindFirstChild("Humanoid")
                    viewBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
                    SendNotification("Reset View", Color3.fromRGB(200, 60, 60))
                else
                    viewTarget = plr
                    if plr.Character and plr.Character:FindFirstChild("Humanoid") then
                        workspace.CurrentCamera.CameraSubject = plr.Character.Humanoid
                    end
                    RefreshPlayerList()
                    SendNotification("Viewing " .. plr.Name, Color3.fromRGB(150, 80, 150))
                end
            end)
            
            selBtn.MouseButton1Click:Connect(function()
                selectedForFling[plr] = not selectedForFling[plr]
                selBtn.Text = selectedForFling[plr] and "Selected" or "Select"
                selBtn.BackgroundColor3 = selectedForFling[plr] and Color3.fromRGB(60, 180, 80) or Color3.fromRGB(200, 60, 60)
            end)
        end
    end
    PlayerScroll.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 10)
end

Players.PlayerAdded:Connect(function() task.wait(1); RefreshPlayerList() end)
Players.PlayerRemoving:Connect(function(plr) 
    selectedForFling[plr] = nil
    if followTarget == plr then followTarget = nil end
    if viewTarget == plr then viewTarget = nil; workspace.CurrentCamera.CameraSubject = LocalPlayer.Character:FindFirstChild("Humanoid") end
    RefreshPlayerList() 
end)

SelectAllBtn.MouseButton1Click:Connect(function()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            selectedForFling[plr] = true
            if toggleButtons[plr] then
                toggleButtons[plr].Text = "Selected"
                toggleButtons[plr].BackgroundColor3 = Color3.fromRGB(60, 180, 80)
            end
        end
    end
    SendNotification("Selected All for Fling", Color3.fromRGB(80, 120, 200))
end)

DeselectAllBtn.MouseButton1Click:Connect(function()
    selectedForFling = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if toggleButtons[plr] then
            toggleButtons[plr].Text = "Select"
            toggleButtons[plr].BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        end
    end
    SendNotification("Deselected All", Color3.fromRGB(200, 60, 60))
end)

RunService.Heartbeat:Connect(function()
    if followTarget and followTarget.Character and followTarget.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local targetCF = followTarget.Character.HumanoidRootPart.CFrame
            myChar.HumanoidRootPart.CFrame = targetCF * CFrame.new(0, followY, -followZ)
        end
    end
    
    if viewTarget and viewTarget.Character and viewTarget.Character:FindFirstChild("Humanoid") then
        if workspace.CurrentCamera.CameraSubject ~= viewTarget.Character.Humanoid then
            workspace.CurrentCamera.CameraSubject = viewTarget.Character.Humanoid
        end
    end
end)

StartFlingBtn.MouseButton1Click:Connect(function()
    local targets = {}
    for plr, sel in pairs(selectedForFling) do
        if sel then table.insert(targets, plr) end
    end
    
    if #targets == 0 then
        SendNotification("No targets selected!", Color3.fromRGB(200, 60, 60))
        return
    end
    
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    
    if not isFlinging then
        originalPos = myChar.HumanoidRootPart.CFrame
        isFlinging = true
        currentFlingIndex = 1
        SendNotification("Multi-Fling Started!", Color3.fromRGB(60, 180, 80))
        
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        
        task.spawn(function()
            while isFlinging do
                local currentTarget = targets[currentFlingIndex]
                if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart") then
                    local startTime = tick()
                    while isFlinging and tick() - startTime < 3 and currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart") do
                        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            local hrp = LocalPlayer.Character.HumanoidRootPart
                            local tHrp = currentTarget.Character.HumanoidRootPart
                            hrp.CFrame = tHrp.CFrame
                            hrp.Velocity = Vector3.new(0, 10000, 0)
                            hrp.RotVelocity = Vector3.new(10000, 10000, 10000)
                        end
                        RunService.Heartbeat:Wait()
                    end
                end
                
                currentFlingIndex = currentFlingIndex + 1
                if currentFlingIndex > #targets then
                    currentFlingIndex = 1
                end
                task.wait(0.1)
            end
        end)
    end
end)

StopFlingBtn.MouseButton1Click:Connect(function()
    if isFlinging then
        isFlinging = false
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local hrp = myChar.HumanoidRootPart
            hrp.Velocity = Vector3.new(0,0,0)
            hrp.RotVelocity = Vector3.new(0,0,0)
            if originalPos then
                hrp.CFrame = originalPos
            end
            for _, part in ipairs(myChar:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then part.CanCollide = true end
            end
        end
        SendNotification("Fling Stopped! Teleported back.", Color3.fromRGB(200, 60, 60))
    end
end)

-- === TAB WECHSEL LOGIK ===
local function SwitchTab(activePage, activeBtn)
    InfoPage.Visible = (activePage == InfoPage)
    PlayerPage.Visible = (activePage == PlayerPage)
    ESPPage.Visible = (activePage == ESPPage)
    VisualsPage.Visible = (activePage == VisualsPage)
    FlingPage.Visible = (activePage == FlingPage)
    
    InfoTabBtn.BackgroundColor3 = Color3.fromRGB(16, 20, 30)
    PlayerTabBtn.BackgroundColor3 = Color3.fromRGB(16, 20, 30)
    ESPTabBtn.BackgroundColor3 = Color3.fromRGB(16, 20, 30)
    VisualsTabBtn.BackgroundColor3 = Color3.fromRGB(16, 20, 30)
    FlingTabBtn.BackgroundColor3 = Color3.fromRGB(16, 20, 30)
    
    activeBtn.BackgroundColor3 = Color3.fromRGB(25, 30, 45)
    
    if activePage == FlingPage then
        RefreshPlayerList()
    end
end

InfoTabBtn.MouseButton1Click:Connect(function() SwitchTab(InfoPage, InfoTabBtn) end)
PlayerTabBtn.MouseButton1Click:Connect(function() SwitchTab(PlayerPage, PlayerTabBtn) end)
ESPTabBtn.MouseButton1Click:Connect(function() SwitchTab(ESPPage, ESPTabBtn) end)
VisualsTabBtn.MouseButton1Click:Connect(function() SwitchTab(VisualsPage, VisualsTabBtn) end)
FlingTabBtn.MouseButton1Click:Connect(function() SwitchTab(FlingPage, FlingTabBtn) end)

