CopyPosBtn.Size = UDim2.new(1, -30, 0, 35)
CopyPosBtn.BackgroundColor3 = Color3.fromRGB(25, 35, 55)
CopyPosBtn.Text = "Copy Position"
CopyPosBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CopyPosBtn.Font = Enum.Font.GothamBold
